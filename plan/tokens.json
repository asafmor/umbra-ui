{
  "$description": "umbra-ui design tokens, version 1 (2026-10-10). Colours are umbra-ui's own values in the same families as the source (reference samples: plan/inventory/source-colours.md). Sizes were measured from a 2560x1440 screenshot and scaled to a 1920-wide window; they are accurate to a pixel or two. Each token becomes a CSS variable, e.g. color.fixed.primary -> --umbra-color-fixed-primary.",

  "color": {
    "fixed": {
      "$description": "Never changes with brand or context. The library's signature.",
      "primary": "#db1065",
      "primaryEnd": "#c2128a",
      "onPrimary": "#ffffff",
      "selected": "#6a1fd6",
      "onSelected": "#ffffff",
      "accentText": "#f77bf0",
      "focusRing": "#ffb3f5"
    },
    "base": {
      "$description": "Dark neutrals for the default (violet) context.",
      "surface1": "#0b0612",
      "surface2": "#1b1329",
      "surface3": "#261b38",
      "surfaceNeutral": "#141a22",
      "borderNeutral": "#232b36",
      "borderSubtle": "#2e2440",
      "borderStrong": "#47395e",
      "borderControl": "#7a6e91",
      "textPrimary": "#f5f3f8",
      "textSecondary": "#b3adbf",
      "textMuted": "#948da2",
      "scrim": "rgba(5, 2, 10, 0.72)"
    },
    "semantic": {
      "success": "#16b877",
      "warning": "#f2b23a",
      "danger": "#f0455a",
      "info": "#3d9be8"
    },
    "valueRamp": {
      "$description": "Five steps for colouring a value by threshold (ValuePill, LevelMeter, ProgressBar). Always paired with the number or a label.",
      "1": "#948da2",
      "2": "#e8823c",
      "3": "#f2c53a",
      "4": "#3fc46f",
      "5": "#21c7c1"
    },
    "series": {
      "$description": "The default categorical palette for series in charts and legends, used in this order. Neighbours stay apart for protan, deutan and tritan vision (worst simulated OKLab distance 11.1), and each has at least 4.8:1 against the card background on every context tint (numbers in plan/specs/Legend.md). Colour is never the only cue: pair it with a label, and with a marker pattern past eight series.",
      "1": "#4a94e8",
      "2": "#e0703a",
      "3": "#1fa88c",
      "4": "#bb880e",
      "5": "#dd5f96",
      "6": "#3f9a2e",
      "7": "#8f7ce8",
      "8": "#e2605a"
    },
    "brand": {
      "$description": "Set by the app. Colours the TopBar. onBrand is computed for contrast (light or dark text).",
      "default": "#2a2f8f"
    },
    "context": {
      "$description": "Set by the app per section. One input colour; the three used values are derived from it.",
      "presets": {
        "violet": "#7a2be0",
        "teal": "#1f8f7f",
        "green": "#1f9a5b",
        "slate": "#5a6670"
      },
      "derive": {
        "pageBackground": "color-mix(in oklab, <input> 14%, #05020a)",
        "pageBackgroundEnd": "color-mix(in oklab, <input> 34%, #05020a)",
        "cardTint": "color-mix(in oklab, <input> 6%, #0b0612)",
        "cardTintStrong": "color-mix(in oklab, <input> 18%, #0b0612)",
        "midAccent": "color-mix(in oklab, <input> 70%, #ffffff)"
      }
    }
  },

  "font": {
    "family": {
      "heading": "'Barlow Condensed', 'Arial Narrow', sans-serif",
      "body": "'Figtree', system-ui, sans-serif"
    },
    "role": {
      "$description": "size / line-height in px, weight. Sizes shown are for the default density.",
      "cardTitle": { "family": "heading", "size": 18, "lineHeight": 20, "weight": 700, "transform": "uppercase" },
      "nav": { "family": "heading", "size": 20, "lineHeight": 24, "weight": 600, "transform": "uppercase" },
      "display": { "family": "body", "size": 28, "lineHeight": 32, "weight": 700 },
      "title": { "family": "body", "size": 19, "lineHeight": 24, "weight": 700 },
      "body": { "family": "body", "size": 16, "lineHeight": 22, "weight": 400 },
      "label": { "family": "body", "size": 13, "lineHeight": 16, "weight": 500 },
      "tableCell": { "family": "body", "size": 13, "lineHeight": 16, "weight": 400 }
    }
  },

  "space": {
    "$description": "4px base scale.",
    "0": 0, "1": 2, "2": 4, "3": 8, "4": 12, "5": 16, "6": 20, "7": 24, "8": 32, "9": 40
  },

  "radius": { "control": 4, "card": 8, "pill": 999 },

  "border": { "width": 1 },

  "elevation": {
    "$description": "Cards are flat with a border. Only overlays cast a shadow.",
    "card": "none",
    "overlay": "0 8px 24px rgba(0, 0, 0, 0.5)"
  },

  "size": {
    "topBarHeight": 60,
    "subNavHeight": 32,
    "scrollThumb": 4,
    "minWindowWidth": 1024,
    "minWindowHeight": 600
  },

  "density": {
    "$description": "Three levels set on the provider. 'default' matches the source at a 1920-wide window.",
    "compact": { "controlHeight": 28, "tableRow": 22, "listRow": 56, "gap": 12, "pageMargin": 16, "cardPadding": 12, "cardMinHeight": 72, "bodySize": 14, "labelSize": 12 },
    "default": { "controlHeight": 36, "tableRow": 26, "listRow": 72, "gap": 20, "pageMargin": 32, "cardPadding": 16, "cardMinHeight": 88, "bodySize": 16, "labelSize": 13 },
    "spacious": { "controlHeight": 44, "tableRow": 32, "listRow": 84, "gap": 24, "pageMargin": 40, "cardPadding": 20, "cardMinHeight": 104, "bodySize": 16, "labelSize": 14 }
  },

  "motion": {
    "duration": { "fast": 100, "base": 180, "slow": 240 },
    "easing": { "enter": "cubic-bezier(0, 0, 0.2, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)" }
  },

  "state": {
    "disabledOpacity": 0.4,
    "focusRingWidth": 2
  }
}
